{
  "name": "@holdsend/web",
  "version": "0.1.0",
  "description": "HoldSend for browsers: an IndexedDB outbox store, one sender across tabs, and honest background-sync helpers.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@holdsend/core": "0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyakuhq/holdsend.git",
    "directory": "packages/web"
  },
  "homepage": "https://zyakuhq.github.io/holdsend/packages/web/",
  "bugs": {
    "url": "https://github.com/zyakuhq/holdsend/issues"
  },
  "keywords": [
    "offline-first",
    "indexeddb",
    "outbox",
    "web-locks",
    "background-sync",
    "pwa"
  ]
}
