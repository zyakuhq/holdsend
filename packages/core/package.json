{
  "name": "@holdsend/core",
  "version": "0.1.0",
  "description": "Offline outbox state machine: idempotency keys, written-at time, max-age confirmation and cancel. No runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyakuhq/holdsend.git",
    "directory": "packages/core"
  },
  "homepage": "https://zyakuhq.github.io/holdsend/packages/core/",
  "bugs": {
    "url": "https://github.com/zyakuhq/holdsend/issues"
  },
  "keywords": [
    "offline",
    "offline-first",
    "outbox",
    "idempotency",
    "exactly-once",
    "queue"
  ]
}
