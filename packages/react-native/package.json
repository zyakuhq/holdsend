{
  "name": "@holdsend/react-native",
  "version": "0.1.1",
  "description": "HoldSend for React Native: an outbox store over AsyncStorage or MMKV, and an auto-flush that you wire to NetInfo and AppState.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@holdsend/core": "0.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyakuhq/holdsend.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://zyakuhq.github.io/holdsend/packages/react-native/",
  "bugs": {
    "url": "https://github.com/zyakuhq/holdsend/issues"
  },
  "keywords": [
    "offline-first",
    "react-native",
    "asyncstorage",
    "mmkv",
    "outbox"
  ]
}
