#!/bin/sh
# Runs the secret scan and the PII scan before every push.
# Enable once per clone:  git config core.hooksPath .githooks
set -e

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --redact --no-banner --exit-code 1 .
else
  # No gitleaks here: scan the tracked files with secretlint (from npm).
  # CI still runs gitleaks over the full history on every pull request.
  node scripts/secret-scan.mjs
fi

node scripts/pii-scan.mjs
