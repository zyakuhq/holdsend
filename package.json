{
  "name": "holdsend-monorepo",
  "private": true,
  "description": "Write offline, publish exactly once.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web",
    "packages/react-native"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "size": "node scripts/size-check.mjs",
    "scan:pii": "node scripts/pii-scan.mjs",
    "check": "npm run lint && npm run build && npm run typecheck && npm test && npm run size && npm run scan:pii"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vitest": "^5.0.5"
  }
}
