{
  "name": "holdsend-monorepo",
  "private": true,
  "description": "Write offline, publish exactly once.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web",
    "packages/react-native",
    "examples/notes",
    "examples/react",
    "examples/expo"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "size": "node scripts/size-check.mjs",
    "scan:pii": "node scripts/pii-scan.mjs",
    "check": "npm run lint && npm run build && npm run typecheck && npm test && npm run size && npm run check:packages && npm run scan:pii && npm run scan:secrets",
    "test:soak": "HOLDSEND_RUNS=3000 vitest run never-twice",
    "e2e": "npm run e2e --workspace holdsend-example-notes && npm run e2e --workspace holdsend-example-react && npm run e2e --workspace holdsend-example-expo",
    "check:packages": "node scripts/check-packages.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.13.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "marked": "^17.0.6",
    "pg": "^8.23.1",
    "secretlint": "13.0.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
